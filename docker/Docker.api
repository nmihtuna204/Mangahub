# Image with only the api-server. The usual way to run MangaHub in Docker is
# docker-compose.yml (one image, see ../Dockerfile); this builds one service.
#   docker build -t mangahub-api -f docker/<this file> .
FROM golang:1.25-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Pure-Go SQLite driver: no C toolchain needed
RUN CGO_ENABLED=0 GOOS=linux go build -o api-server ./cmd/api-server

FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /build/api-server .
COPY configs/ ./configs/
RUN mkdir -p /app/data

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./api-server"]
